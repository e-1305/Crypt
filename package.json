{
  "name": "crypt-cli",
  "version": "0.1.0",
  "private": true,
  "description": "CRYPT: your dependency tree as a Z-machine creature. One command (crypt raid) finds the rotting limbs and opens dry-run fix payloads.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "crypt": "bin/crypt.mjs"
  },
  "files": [
    "bin",
    "scripts",
    "src",
    "game",
    "fixtures/vulnerable-npm",
    "data/cache/osv",
    "README.md",
    "LICENSE",
    "docs/ATTRIBUTION.md"
  ],
  "scripts": {
    "setup": "bash scripts/setup-tools.sh",
    "build:game": "bash scripts/setup-tools.sh && bash scripts/build-game.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "spike": "bash scripts/setup-tools.sh && bash scripts/build-game.sh && tsx scripts/reset.ts && tsx scripts/play.ts && tsx src/bridge/watch.ts --once && tsx scripts/check-spike.ts",
    "feeds:update": "tsx scripts/feeds-update.ts",
    "exhume": "tsx scripts/exhume.ts",
    "raise": "bash scripts/setup-tools.sh && tsx scripts/raise.ts",
    "raise:check": "tsx scripts/check-raise.ts",
    "necromancer": "tsx scripts/necromancer.ts",
    "inquisitor": "tsx scripts/inquisitor.ts",
    "reraise": "tsx scripts/reraise.ts",
    "necromancer:check": "tsx scripts/check-necromancer.ts",
    "plate": "tsx scripts/plate.ts",
    "census": "npm run feeds:update && tsx scripts/census/run.ts",
    "web": "tsx scripts/web.ts",
    "mcp": "tsx scripts/mcp.ts",
    "build:web": "tsc -p tsconfig.web.json",
    "build:site": "bash scripts/setup-tools.sh && tsx scripts/build-site.ts",
    "gallery:snapshot": "tsx scripts/gallery-snapshot.ts",
    "crypt": "node bin/crypt.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
