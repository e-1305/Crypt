! CRYPT transcript-bridge spike: one room, one object, three verbs (GRAFT prints the marker for the noun).
Constant Story "The Crypt";
Constant Headline "^A transcript bridge spike.^";

Include "Parser";
Include "VerbLib";

[ Initialise;
    location = Crypt;
    "^You wake in the dark.^";
];

Object Crypt "The Crypt"
  with description "A cold stone vault. Something rots here.",
  has light;

Object arm "arm" Crypt
  with name 'arm' 'limb' 'rotting',
       limbid "ARM",
       description [;
           print "[[CRYPT EXAMINE ARM]]^";
           print "A rotting limb, grey and slack, begging for a graft.^";
           rtrue;
       ],
  has static;

[ GraftSub;
    print "[[CRYPT GRAFT "; print (string) noun.limbid; print "]]^";
    "The surgeon begins the graft.";
];

[ SealSub;
    print "[[CRYPT SEAL]]^";
    "The crypt is sealed.";
];

Include "Grammar";

Verb 'graft'
    * noun                      -> Graft;

Verb 'seal'
    * 'crypt'                   -> Seal;
